+#[cfg(test)]
+mod command_capture_tests {
+    use crate::prelude::*;
+
+    use super::{capture_command_allowed, json_escape};
+
+    #[test]
+    fn command_capture_allowlist_excludes_tty_sensitive_commands() {
+        assert!(capture_command_allowed(L!("cat")));
+        assert!(capture_command_allowed(L!("printf")));
+        assert!(!capture_command_allowed(L!("ssh")));
+        assert!(!capture_command_allowed(L!("less")));
+    }
+
+    #[test]
+    fn command_capture_allowlist_requires_a_basename() {
+        assert!(capture_command_allowed(L!("/bin/cat")));
+        assert!(!capture_command_allowed(L!("ssh")));
+    }
+
+    #[test]
+    fn command_capture_json_escapes_structural_characters() {
+        assert_eq!(json_escape(b"a\n\"b\\"), "a\\n\\\"b\\\\");
+    }
+}

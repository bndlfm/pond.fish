+/// Commands eligible for the deliberately conservative first capture slice. This table is kept
+/// separate so it can be generated from Pond's policy without changing execution code.
+fn capture_command_allowed(command: &wstr) -> bool {
+    let basename = wbasename(command);
+    include_str!("command_capture_allowlist.txt")
+        .lines()
+        .map(str::trim)
+        .any(|entry| {
+            !entry.is_empty()
+                && !entry.starts_with('#')
+                && entry.as_bytes() == wcs2bytes(basename).as_slice()
+        })
+}
+
+struct CaptureSetup {
+    stdout_read: OwnedFd,
+    stdout_write: OwnedFd,
+    stderr_read: OwnedFd,
+    stderr_write: OwnedFd,
+    path: std::ffi::OsString,
+    command: String,
+    timestamp_ms: u128,
+}
+
+struct CaptureRecord {
+    stdout: JoinHandle<Vec<u8>>,
+    stderr: JoinHandle<Vec<u8>>,
+    path: std::ffi::OsString,
+    command: String,
+    timestamp_ms: u128,
+}
+
+static COMMAND_CAPTURES: std::sync::LazyLock<Mutex<HashMap<Pid, CaptureRecord>>> =
+    std::sync::LazyLock::new(|| Mutex::new(HashMap::new()));
+
+/// Prepare two tee-like pipes only for a single, unredirected external command whose output is
+/// currently attached directly to terminal fds. Failure to prepare capture simply preserves normal
+/// execution.
+fn setup_command_capture(j: &Job, p: &Process, dup2s: &mut Dup2List) -> Option<CaptureSetup> {
+    if j.processes().len() != 1
+        || !p.is_first_in_job
+        || !p.is_last_in_job
+        || !isatty(STDOUT_FILENO)
+        || !isatty(STDERR_FILENO)
+        || dup2s.fd_for_target_fd(STDOUT_FILENO) != STDOUT_FILENO
+        || dup2s.fd_for_target_fd(STDERR_FILENO) != STDERR_FILENO
+        || !capture_command_allowed(wbasename(&p.actual_cmd))
+    {
+        return None;
+    }
+    let path = std::env::var_os("FISH_COMMAND_CAPTURE_PATH")?;
+    let stdout = make_autoclose_pipes().ok()?;
+    let stderr = make_autoclose_pipes().ok()?;
+    dup2s.add_dup2(stdout.write.as_raw_fd(), STDOUT_FILENO);
+    dup2s.add_dup2(stderr.write.as_raw_fd(), STDERR_FILENO);
+    Some(CaptureSetup {
+        stdout_read: stdout.read,
+        stdout_write: stdout.write,
+        stderr_read: stderr.read,
+        stderr_write: stderr.write,
+        path,
+        command: String::from_utf8_lossy(&wcs2bytes(&p.actual_cmd)).into_owned(),
+        timestamp_ms: SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .ok()?
+            .as_millis(),
     })
 }
 
+fn register_command_capture(p: &Process, setup: CaptureSetup) {
+    let CaptureSetup {
+        stdout_read,
+        stdout_write,
+        stderr_read,
+        stderr_write,
+        path,
+        command,
+        timestamp_ms,
+    } = setup;
+    // The parent must close both write ends before reading, otherwise EOF can never reach the
+    // reader threads (the child copies these fds during fork/exec).
+    drop(stdout_write);
+    drop(stderr_write);
+    let stdout = std::thread::spawn(move || capture_stream(stdout_read, STDOUT_FILENO));
+    let stderr = std::thread::spawn(move || capture_stream(stderr_read, STDERR_FILENO));
+    COMMAND_CAPTURES.lock().unwrap().insert(
+        p.pid().unwrap(),
+        CaptureRecord {
+            stdout,
+            stderr,
+            path,
+            command,
+            timestamp_ms,
+        },
+    );
+}
+
+fn capture_stream(read_fd: OwnedFd, display_fd: RawFd) -> Vec<u8> {
+    let mut reader = std::fs::File::from(read_fd);
+    let mut captured = Vec::new();
+    let mut buffer = [0u8; 8192];
+    loop {
+        let Ok(count) = reader.read(&mut buffer) else {
+            break;
+        };
+        if count == 0 {
+            break;
+        }
+        captured.extend_from_slice(&buffer[..count]);
+        let mut displayed = 0;
+        while displayed < count {
+            let written = unsafe {
+                libc::write(
+                    display_fd,
+                    buffer[displayed..count].as_ptr().cast(),
+                    count - displayed,
+                )
+            };
+            if written <= 0 {
+                break;
+            }
+            displayed += written as usize;
+        }
+    }
+    captured
+}
+
+fn json_escape(bytes: &[u8]) -> String {
+    let mut out = String::new();
+    for ch in String::from_utf8_lossy(bytes).chars() {
+        match ch {
+            '\\' => out.push_str("\\\\"),
+            '"' => out.push_str("\\\""),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if c.is_control() => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+/// Called by the reaper after the child has exited, which is the lifecycle seam needed to include
+/// the real exit status in the JSONL record.
+pub(crate) fn finish_command_capture(pid: Pid, exit_status: i32) {
+    let Some(record) = COMMAND_CAPTURES.lock().unwrap().remove(&pid) else {
+        return;
+    };
+    let stdout = record.stdout.join().unwrap_or_default();
+    let stderr = record.stderr.join().unwrap_or_default();
+    let line = format!(
+        "{{\"timestamp\":{},\"command\":\"{}\",\"stdout\":\"{}\",\"stderr\":\"{}\",\"exit_status\":{}}}\n",
+        record.timestamp_ms,
+        json_escape(record.command.as_bytes()),
+        json_escape(&stdout),
+        json_escape(&stderr),
+        exit_status
+    );
+    if let Ok(mut file) = OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(record.path)
+    {
+        let _ = file.write_all(line.as_bytes());
+    }
+}
